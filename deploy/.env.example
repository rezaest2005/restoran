# Copy to deploy/.env and fill in. Never commit the real file.

# --- Django ---
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080
# Set both to True when served over HTTPS
COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# --- Branding (optional; defaults live in dashboard/core/branding.py) ---
# APP_NAME=Business Suite
# APP_NAME_FA=

# --- Database (used by both the db container and the Django services) ---
DB_NAME=bizsuite
DB_USER=bizsuite
DB_PASSWORD=

# --- Shared domain (optional) ---
# Leave empty when this app owns the whole domain. Set e.g. /biz when a reverse proxy gives it
# https://example.com/biz/ and strips the prefix (see docs/DEPLOY.md). Rebuild the images after changing it.
URL_PREFIX=

# --- Published web port ---
WEB_PORT=8080

# --- Bootstrap users (applied by the one-shot migrate service) ---
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_USERNAME=superadmin
BOOTSTRAP_SUPER_PASSWORD=
BOOTSTRAP_SYNC_PASSWORDS=0

# --- Integrations ---
CARD_READER_IP=
CARD_READER_PORT=8080
CARD_READER_TIMEOUT=10
PUBLIC_PASSWORD_RESET_ENABLED=False
