# نمونه‌ی تنظیمات — این فایل را به `.env` کپی کنید و مقدارها را پر کنید.
# فایل `.env` واقعی هرگز commit نمی‌شود.

SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000

DB_NAME=bizsuite
DB_USER=bizsuite
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5433

CARD_READER_IP=192.168.1.100
CARD_READER_PORT=8080
CARD_READER_TIMEOUT=10

# کاربران اولیه (فقط هنگام راه‌اندازی)
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_USERNAME=superadmin
BOOTSTRAP_SUPER_PASSWORD=
BOOTSTRAP_SYNC_PASSWORDS=0

# بازیابی رمز عمومی فقط بعد از اتصال OTP فعال شود
PUBLIC_PASSWORD_RESET_ENABLED=False

# پشت HTTPS در production هر دو را True کنید
COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# نام محصول (اختیاری؛ پیش‌فرض در dashboard/core/branding.py)
# APP_NAME=Business Suite
# APP_NAME_FA=
